# Copy this file to .env and fill in real values:  cp .env.example .env
# .env is gitignored.

# SQLite database location. Can be a relative path (sqlite://sqlite.db)
# or absolute (sqlite:///var/lib/url-shortener/sqlite.db).
DATABASE_URL=sqlite://sqlite.db

# Address the server binds to. Keep this as 127.0.0.1 in production and let
# nginx/Caddy terminate TLS and forward traffic to it.
BIND_ADDRESS=127.0.0.1:3000

# Paths to newline-separated blocklist files. Set to empty to allow everything.
DOMAIN_BLOCKLIST=data/domain-blocklist.txt
SLUG_BLOCKLIST=data/slug-blocklist.txt

# Secret used to sign cookies (link-access and admin session cookies).
# Must be base64-encoded and decode to at least 64 bytes. Generate one with:
#   openssl rand -base64 64
COOKIE_SECRET=

# Password required to view click statistics (admin login on /{slug}/stats).
ADMIN_PASSWORD=

# Whether session cookies are marked Secure (only sent over HTTPS). Set to
# true in production; false only for local development over plain HTTP.
COOKIE_SECURE=true
